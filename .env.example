# Database
FISHORA_DATABASE_URL=postgresql+psycopg://fishora:fishora@localhost:55432/fishora

# run_local.sh derives the API base URL and CORS allow-list from these.
FISHORA_MAIN_API_PORT=8000
FISHORA_CV_SERVICE_PORT=8001
FISHORA_FRONTEND_PORT=3000

# NEXT_PUBLIC_API_BASE_URL is compiled into the browser bundle, so it must be
# reachable from the browser. FISHORA_CORS_ALLOW_ORIGINS is comma-separated;
# blank denies every origin and there is no wildcard.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FISHORA_CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to 1 to start only the backend and CV service.
FISHORA_SKIP_FRONTEND=0

# Docker (`docker compose up --build`) reads this same file. Uncomment to also
# start the CV service, which needs the export under ai/ and an NVIDIA GPU.
# COMPOSE_PROFILES=cv
# Set to 0 to skip seeding demo lots into an empty database on first start.
# FISHORA_SEED_DEMO_LOTS=1

# CV service client
FISHORA_CV_SERVICE_URL=http://localhost:8001
FISHORA_CV_TIMEOUT_SECONDS=30
FISHORA_CV_MAX_IMAGE_BYTES=10485760
FISHORA_IMAGE_STORAGE_DIR=data/images

# Local CV service. Set this to the directory containing
# model_state_dict.pt, inference_config.json, and inference.py.
FISHORA_CV_EXPORT_DIR=ai/results/fishora_dinov3_large_frozen/export
FISHORA_CV_DEVICE=cuda
FISHORA_CV_MODEL_VERSION=fishora-dinov3-export

# Embeddings
FISHORA_EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
FISHORA_EMBEDDING_DIMENSION=768
FISHORA_EMBEDDING_DEVICE=cpu

# OpenCode Go LLM. All orchestration agents use Luna.
FISHORA_OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
FISHORA_OPENCODE_GO_MODEL=gpt-6-luna
FISHORA_OPENCODE_GO_TIMEOUT_SECONDS=60
OPENCODE_GO_API_KEY=
